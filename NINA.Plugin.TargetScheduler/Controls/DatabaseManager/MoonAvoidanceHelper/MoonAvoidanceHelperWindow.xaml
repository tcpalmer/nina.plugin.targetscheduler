<Window
    x:Class="NINA.Plugin.TargetScheduler.Controls.DatabaseManager.MoonAvoidanceHelper.MoonAvoidanceHelperWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:oxy="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Contrib.Wpf"
    Title="Moon Avoidance Helper"
    Width="720"
    MinWidth="540"
    Background="{StaticResource BackgroundBrush}"
    Foreground="{StaticResource PrimaryBrush}"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary Source="../../Resources/Resources.xaml" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Avoidance plot: classic separation across a lunation (moon age 0-30 days).  Fixed height so the
              window (SizeToContent=Height) sizes to its content and the plot is never truncated.  -->
        <oxy:Plot
            Grid.Row="0"
            Height="280"
            Background="{StaticResource BackgroundBrush}"
            PlotAreaBackground="{StaticResource SecondaryBackgroundBrush}"
            PlotAreaBorderColor="{Binding Path=Color, Source={StaticResource BorderBrush}}">
            <oxy:Plot.Axes>
                <oxy:LinearAxis
                    AxislineColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}}"
                    IsPanEnabled="False"
                    IsZoomEnabled="False"
                    MajorGridlineColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}, Converter={StaticResource SetAlphaToColorConverter}, ConverterParameter=60}"
                    MajorGridlineStyle="Solid"
                    MajorStep="5"
                    Maximum="30"
                    Minimum="-0.5"
                    MinorStep="1"
                    Position="Bottom"
                    TextColor="#FFF6F1D5"
                    TicklineColor="{Binding Path=Color, Source={StaticResource SecondaryBrush}}" />
                <oxy:LinearAxis
                    AxislineColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}}"
                    IsPanEnabled="False"
                    IsZoomEnabled="False"
                    MajorGridlineColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}, Converter={StaticResource SetAlphaToColorConverter}, ConverterParameter=60}"
                    MajorGridlineStyle="Solid"
                    MajorStep="30"
                    Maximum="180"
                    Minimum="0"
                    MinorStep="10"
                    Position="Left"
                    TextColor="#FFF6F1D5"
                    TicklineColor="{Binding Path=Color, Source={StaticResource SecondaryBrush}}" />
            </oxy:Plot.Axes>
            <oxy:Plot.Legends>
                <oxy:Legend
                    LegendBackground="#40000000"
                    LegendPlacement="Inside"
                    LegendPosition="TopRight"
                    LegendTextColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}}" />
            </oxy:Plot.Legends>
            <oxy:Plot.Series>
                <oxy:LineSeries
                    Title="Classic"
                    Color="#FF5B9BD5"
                    DataFieldX="X"
                    DataFieldY="Y"
                    ItemsSource="{Binding AvoidancePoints}"
                    MarkerFill="#FF5B9BD5"
                    MarkerSize="3"
                    MarkerType="Circle"
                    StrokeThickness="2" />
                <oxy:LineSeries
                    Title="Relaxed"
                    Color="#FFED7D31"
                    DataFieldX="X"
                    DataFieldY="Y"
                    ItemsSource="{Binding RelaxedPoints}"
                    MarkerFill="#FFED7D31"
                    MarkerSize="3"
                    MarkerType="Circle"
                    StrokeThickness="2"
                    Visibility="{Binding ShowRelaxed, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
            </oxy:Plot.Series>
            <oxy:Plot.Annotations>
                <!--  Moon phase markers across the lunation (29.53059 days)  -->
                <oxy:LineAnnotation
                    Color="#FFF6F1D5"
                    FontSize="11"
                    LineStyle="Solid"
                    StrokeThickness="1"
                    Text="New"
                    TextColor="#FFF6F1D5"
                    TextHorizontalAlignment="Left"
                    TextOrientation="Horizontal"
                    TextVerticalAlignment="Top"
                    Type="Vertical"
                    X="0" />
                <oxy:LineAnnotation
                    Color="#FFF6F1D5"
                    FontSize="11"
                    LineStyle="Solid"
                    StrokeThickness="1"
                    Text="1st Qtr"
                    TextColor="#FFF6F1D5"
                    TextHorizontalAlignment="Center"
                    TextOrientation="Horizontal"
                    TextVerticalAlignment="Top"
                    Type="Vertical"
                    X="7.3826475" />
                <oxy:LineAnnotation
                    Color="#FFF6F1D5"
                    FontSize="11"
                    LineStyle="Solid"
                    StrokeThickness="1"
                    Text="Full"
                    TextColor="#FFF6F1D5"
                    TextHorizontalAlignment="Center"
                    TextOrientation="Horizontal"
                    TextVerticalAlignment="Top"
                    Type="Vertical"
                    X="14.765295" />
                <oxy:LineAnnotation
                    Color="#FFF6F1D5"
                    FontSize="11"
                    LineStyle="Solid"
                    StrokeThickness="1"
                    Text="3rd Qtr"
                    TextColor="#FFF6F1D5"
                    TextHorizontalAlignment="Center"
                    TextOrientation="Horizontal"
                    TextVerticalAlignment="Top"
                    Type="Vertical"
                    X="22.1479425" />
                <oxy:LineAnnotation
                    Color="#FFF6F1D5"
                    FontSize="11"
                    LineStyle="Solid"
                    StrokeThickness="1"
                    Text="New"
                    TextColor="#FFF6F1D5"
                    TextHorizontalAlignment="Right"
                    TextOrientation="Horizontal"
                    TextVerticalAlignment="Top"
                    Type="Vertical"
                    X="29.53059" />
            </oxy:Plot.Annotations>
        </oxy:Plot>

        <!--  Classic Avoidance controls  -->
        <TextBlock
            Grid.Row="1"
            Margin="0,12,0,6"
            FontSize="14"
            FontWeight="Bold"
            Text="Classic Avoidance" />

        <Grid Grid.Row="2" Margin="12,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Enabled  -->
            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,5"
                VerticalAlignment="Center"
                FontWeight="Bold"
                Text="Enabled"
                ToolTip="Enable classic Lorentzian moon avoidance" />
            <CheckBox
                Grid.Row="0"
                Grid.Column="1"
                Margin="0,5"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                IsChecked="{Binding ClassicEnabled, Mode=TwoWay}" />

            <!--  Separation  -->
            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,5"
                VerticalAlignment="Center"
                FontWeight="Bold"
                IsEnabled="{Binding ClassicEnabled}"
                Text="Separation"
                ToolTip="Classic moon avoidance separation"
                ToolTipService.ShowOnDisabled="True" />
            <ScrollBar
                Grid.Row="1"
                Grid.Column="1"
                Height="18"
                VerticalAlignment="Center"
                IsEnabled="{Binding ClassicEnabled}"
                LargeChange="1"
                Maximum="180"
                Minimum="0"
                Orientation="Horizontal"
                SmallChange="1"
                Value="{Binding ClassicSeparation, Mode=TwoWay}" />
            <TextBlock
                Grid.Row="1"
                Grid.Column="2"
                MinWidth="44"
                Margin="10,5,0,5"
                VerticalAlignment="Center"
                IsEnabled="{Binding ClassicEnabled}"
                Text="{Binding ClassicSeparation, StringFormat={}{0:0}°}"
                TextAlignment="Right" />

            <!--  Width  -->
            <TextBlock
                Grid.Row="2"
                Grid.Column="0"
                Margin="0,5"
                VerticalAlignment="Center"
                FontWeight="Bold"
                IsEnabled="{Binding ClassicEnabled}"
                Text="Width"
                ToolTip="Classic moon avoidance width"
                ToolTipService.ShowOnDisabled="True" />
            <ScrollBar
                Grid.Row="2"
                Grid.Column="1"
                Height="18"
                VerticalAlignment="Center"
                IsEnabled="{Binding ClassicEnabled}"
                LargeChange="1"
                Maximum="14"
                Minimum="1"
                Orientation="Horizontal"
                SmallChange="1"
                Value="{Binding ClassicWidth, Mode=TwoWay}" />
            <TextBlock
                Grid.Row="2"
                Grid.Column="2"
                MinWidth="44"
                Margin="10,5,0,5"
                VerticalAlignment="Center"
                IsEnabled="{Binding ClassicEnabled}"
                Text="{Binding ClassicWidth}"
                TextAlignment="Right" />
        </Grid>

        <!--  Relaxed controls  -->
        <TextBlock
            Grid.Row="3"
            Margin="0,12,0,6"
            FontSize="14"
            FontWeight="Bold"
            Text="Relaxed" />

        <Grid Grid.Row="4" Margin="12,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Scale  -->
            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,5"
                VerticalAlignment="Center"
                FontWeight="Bold"
                IsEnabled="{Binding ClassicEnabled}"
                Text="Scale"
                ToolTip="Scale the impact or disable relaxation"
                ToolTipService.ShowOnDisabled="True" />
            <ComboBox
                Grid.Row="0"
                Grid.Column="1"
                Width="80"
                Height="22"
                Margin="0,5"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                IsEnabled="{Binding ClassicEnabled}"
                ItemsSource="{Binding RelaxScaleChoices}"
                SelectedValue="{Binding RelaxScale, Converter={StaticResource RelaxScaleChoicesConverter}, Mode=TwoWay}" />

            <!--  Min Alt  -->
            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,5"
                VerticalAlignment="Center"
                FontWeight="Bold"
                IsEnabled="{Binding RelaxEnabled}"
                Text="Min Alt"
                ToolTip="Minimum altitude for relaxation, avoidance is disabled completely if moon is lower than this"
                ToolTipService.ShowOnDisabled="True" />
            <ScrollBar
                Grid.Row="1"
                Grid.Column="1"
                Height="18"
                VerticalAlignment="Center"
                IsEnabled="{Binding RelaxEnabled}"
                LargeChange="1"
                Maximum="0"
                Minimum="-90"
                Orientation="Horizontal"
                SmallChange="1"
                Value="{Binding RelaxMinAltitude, Mode=TwoWay}" />
            <TextBlock
                Grid.Row="1"
                Grid.Column="2"
                MinWidth="44"
                Margin="10,5,0,5"
                VerticalAlignment="Center"
                IsEnabled="{Binding RelaxEnabled}"
                Text="{Binding RelaxMinAltitude, StringFormat={}{0:0}°}"
                TextAlignment="Right" />

            <!--  Max Alt  -->
            <TextBlock
                Grid.Row="2"
                Grid.Column="0"
                Margin="0,5"
                VerticalAlignment="Center"
                FontWeight="Bold"
                IsEnabled="{Binding RelaxEnabled}"
                Text="Max Alt"
                ToolTip="Maximum altitude for relaxation, classic avoidance applies if moon is above this"
                ToolTipService.ShowOnDisabled="True" />
            <ScrollBar
                Grid.Row="2"
                Grid.Column="1"
                Height="18"
                VerticalAlignment="Center"
                IsEnabled="{Binding RelaxEnabled}"
                LargeChange="1"
                Maximum="30"
                Minimum="0"
                Orientation="Horizontal"
                SmallChange="1"
                Value="{Binding RelaxMaxAltitude, Mode=TwoWay}" />
            <TextBlock
                Grid.Row="2"
                Grid.Column="2"
                MinWidth="44"
                Margin="10,5,0,5"
                VerticalAlignment="Center"
                IsEnabled="{Binding RelaxEnabled}"
                Text="{Binding RelaxMaxAltitude, StringFormat={}{0:0}°}"
                TextAlignment="Right" />

            <!--  Altitude (preview only) - labeled in the relaxed-curve color since it previews that curve  -->
            <TextBlock
                Grid.Row="3"
                Grid.Column="0"
                Margin="0,5"
                VerticalAlignment="Center"
                FontWeight="Bold"
                Foreground="#FFED7D31"
                IsEnabled="{Binding RelaxEnabled}"
                Text="Altitude"
                ToolTip="Assumed moon altitude for previewing the relaxed curve (not saved)"
                ToolTipService.ShowOnDisabled="True" />
            <ScrollBar
                Grid.Row="3"
                Grid.Column="1"
                Height="18"
                VerticalAlignment="Center"
                IsEnabled="{Binding RelaxEnabled}"
                LargeChange="1"
                Maximum="90"
                Minimum="-90"
                Orientation="Horizontal"
                SmallChange="1"
                Value="{Binding Altitude, Mode=TwoWay}" />
            <TextBlock
                Grid.Row="3"
                Grid.Column="2"
                MinWidth="44"
                Margin="10,5,0,5"
                VerticalAlignment="Center"
                IsEnabled="{Binding RelaxEnabled}"
                Text="{Binding Altitude, StringFormat={}{0:0}°}"
                TextAlignment="Right" />

            <!--  Moon Down  -->
            <TextBlock
                Grid.Row="4"
                Grid.Column="0"
                Margin="0,5"
                VerticalAlignment="Center"
                FontWeight="Bold"
                IsEnabled="{Binding RelaxEnabled}"
                Text="Moon Down"
                ToolTip="Moon avoidance is absolute above the relax Maximum Altitude, regardless of actual separation or moon phase"
                ToolTipService.ShowOnDisabled="True" />
            <CheckBox
                Grid.Row="4"
                Grid.Column="1"
                Margin="0,5"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                IsChecked="{Binding MoonDownEnabled, Mode=TwoWay}"
                IsEnabled="{Binding RelaxEnabled}" />
        </Grid>

        <!--  Show Example: cascading Profile / Project / Target / Filter selection plus an example date  -->
        <Expander
            Grid.Row="5"
            Margin="0,12,0,0"
            Header="Show Example"
            IsExpanded="{Binding ShowExample, Mode=TwoWay}">
            <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Avoidance altitude chart (moon separation + avoidance/rejection across the night)  -->
                <ContentControl
                    Grid.Row="0"
                    Width="600"
                    Height="200"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Center"
                    Content="{Binding ExampleChart}" />

                <!--  Cascading selection plus example date  -->
                <Grid Grid.Row="1" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Profile  -->
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,4"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="Profile" />
                    <ComboBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Height="22"
                        Margin="0,4"
                        DisplayMemberPath="Value"
                        ItemsSource="{Binding ProfileChoices}"
                        SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" />

                    <!--  Project  -->
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,4"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="Project" />
                    <ComboBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Height="22"
                        Margin="0,4"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding ProjectChoices}"
                        SelectedItem="{Binding SelectedProject, Mode=TwoWay}" />

                    <!--  Target  -->
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="0,4"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="Target" />
                    <ComboBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Height="22"
                        Margin="0,4"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding TargetChoices}"
                        SelectedItem="{Binding SelectedTarget, Mode=TwoWay}" />

                    <!--  Date with decrement / increment arrows and calendar  -->
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="0,8,0,4"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="Date" />
                    <StackPanel
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="0,8,0,4"
                        Orientation="Horizontal">
                        <Button
                            Width="24"
                            Height="26"
                            Command="{Binding PreviousDayCommand}"
                            Content="&#x25C0;"
                            ToolTip="Previous day" />
                        <DatePicker
                            Width="160"
                            Height="26"
                            Margin="4,0"
                            VerticalContentAlignment="Center"
                            SelectedDate="{Binding ExampleDate, Mode=TwoWay}" />
                        <Button
                            Width="24"
                            Height="26"
                            Command="{Binding NextDayCommand}"
                            Content="&#x25B6;"
                            ToolTip="Next day" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Expander>

        <!--  Save / Cancel  -->
        <StackPanel
            Grid.Row="6"
            Margin="0,16,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Height="28"
                Margin="0,0,8,0"
                Click="SaveButton_Click"
                Content="Save"
                IsDefault="True" />
            <Button
                Width="80"
                Height="28"
                Click="CancelButton_Click"
                Content="Cancel"
                IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
