<ResourceDictionary
    x:Class="NINA.Plugin.TargetScheduler.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ai="clr-namespace:NINA.Plugin.TargetScheduler.Controls.AcquiredImages"
    xmlns:dm="clr-namespace:NINA.Plugin.TargetScheduler.Controls.DatabaseManager"
    xmlns:pp="clr-namespace:NINA.Plugin.TargetScheduler.Controls.PlanPreview"
    xmlns:rp="clr-namespace:NINA.Plugin.TargetScheduler.Controls.Reporting"
    xmlns:tp="clr-namespace:NINA.Plugin.TargetScheduler.Controls.Planning">

    <!--
        Top-level section expander: NINA's down expander, with a shaded header bar and the content indented behind a
        vertical guide line so that open sections are visually separated.  Not BasedOn the NINA implicit style since
        its ExpandDirection trigger would replace this template.
    -->
    <Style x:Key="SectionExpanderStyle" TargetType="{x:Type Expander}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="ExpandDirection" Value="Down" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Expander}">
                    <DockPanel>
                        <Border
                            Padding="4,4,4,4"
                            Background="{StaticResource SecondaryBackgroundBrush}"
                            CornerRadius="3"
                            DockPanel.Dock="Top">
                            <ToggleButton
                                MinWidth="0"
                                MinHeight="0"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                Content="{TemplateBinding Header}"
                                FocusVisualStyle="{StaticResource ExpanderHeaderFocusVisual}"
                                Foreground="{TemplateBinding Foreground}"
                                IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                Style="{StaticResource ExpanderDownHeaderStyle}" />
                        </Border>
                        <Border
                            x:Name="ExpandSite"
                            Margin="11,6,0,10"
                            Padding="12,0,0,0"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="2,0,0,0"
                            DockPanel.Dock="Bottom"
                            Visibility="Collapsed">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Focusable="False" />
                        </Border>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="Target Scheduler_Options">
        <StackPanel DataContext="{Binding}" Orientation="Vertical">

            <Expander
                Margin="0,10,0,10"
                Style="{StaticResource SectionExpanderStyle}"
                IsExpanded="{Binding DatabaseManagerIsExpanded}">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            FontSize="14"
                            FontWeight="Bold"
                            Text="Target Management"
                            ToolTip="Manage your projects, targets, and exposure plans" />
                        <dm:DocumentationLink Margin="5,2,0,0" URL="target-management/index.html" />
                    </StackPanel>
                </Expander.Header>
                <dm:DatabaseManagerView DataContext="{Binding DatabaseManagerVM}" />
            </Expander>

            <Expander
                Margin="0,0,0,10"
                Style="{StaticResource SectionExpanderStyle}"
                IsExpanded="{Binding TargetPlanningIsExpanded}">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            FontSize="14"
                            FontWeight="Bold"
                            Text="Target Planning"
                            ToolTip="Plan future imaging targets" />
                        <dm:DocumentationLink Margin="5,2,0,0" URL="target-planner.html" />
                    </StackPanel>
                </Expander.Header>
                <tp:TargetPlanningView DataContext="{Binding TargetPlanningViewVM}" />
            </Expander>

            <Expander
                Margin="0,0,0,10"
                Style="{StaticResource SectionExpanderStyle}"
                IsExpanded="{Binding PlanPreviewIsExpanded}">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            FontSize="14"
                            FontWeight="Bold"
                            Text="Scheduler Preview"
                            ToolTip="Preview and troubleshoot plans" />
                        <dm:DocumentationLink Margin="5,2,0,0" URL="scheduler-preview.html" />
                    </StackPanel>
                </Expander.Header>
                <pp:PlanPreviewerView DataContext="{Binding PlanPreviewerViewVM}" />
            </Expander>

            <Expander
                Margin="0,0,0,10"
                Style="{StaticResource SectionExpanderStyle}"
                Expanded="ReportingExpander_Expanded"
                IsExpanded="{Binding ReportingManagerIsExpanded}">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            FontSize="14"
                            FontWeight="Bold"
                            Text="Reporting"
                            ToolTip="See reports" />
                        <dm:DocumentationLink Margin="5,2,0,0" URL="post-acquisition/reporting.html" />
                    </StackPanel>
                </Expander.Header>
                <rp:ReportingManagerView DataContext="{Binding ReportingManagerViewVM}" />
            </Expander>

            <Expander
                Margin="0,0,0,20"
                Style="{StaticResource SectionExpanderStyle}"
                IsExpanded="{Binding AcquiredImagesManagerIsExpanded}">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            FontSize="14"
                            FontWeight="Bold"
                            Text="Acquired Images"
                            ToolTip="View details on acquired images" />
                        <dm:DocumentationLink Margin="5,2,0,0" URL="post-acquisition/acquisition-data.html" />
                    </StackPanel>
                </Expander.Header>
                <ai:AcquiredImagesManagerView DataContext="{Binding AcquiredImagesManagerViewVM}" />
            </Expander>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>