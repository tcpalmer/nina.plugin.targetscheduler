<UserControl
    x:Class="NINA.Plugin.TargetScheduler.Controls.Planning.TargetPlanningView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:astro="clr-namespace:NINA.Plugin.TargetScheduler.Astrometry"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dm="clr-namespace:NINA.Plugin.TargetScheduler.Controls.DatabaseManager"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ninactrl="clr-namespace:NINA.CustomControlLibrary;assembly=NINA.CustomControlLibrary"
    xmlns:nrules="clr-namespace:NINA.Core.Utility.ValidationRules;assembly=NINA.Core"
    xmlns:ns="clr-namespace:NINA.Core.Locale;assembly=NINA.Core"
    xmlns:oxy="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf"
    xmlns:rules="clr-namespace:NINA.Plugin.TargetScheduler.Controls.ValidationRules"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Marks a parameter that differs from the value seeded from the selected target  -->
            <Style x:Key="ModifiedMarker" TargetType="TextBlock">
                <Setter Property="Margin" Value="4,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                <Setter Property="Text" Value="*" />
                <Setter Property="ToolTip" Value="Changed from the selected target's value" />
            </Style>

            <!--  Space between label, control, and parameter group columns  -->
            <GridLength x:Key="ColumnGap">24</GridLength>

            <!--  Elements specific to one target source are hidden (not collapsed) in the other so the layout doesn't shift when switching  -->
            <Style x:Key="ManualTargetOnly" TargetType="FrameworkElement">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding UseManualTarget}" Value="False">
                        <Setter Property="Visibility" Value="Hidden" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ExistingTargetOnly" TargetType="FrameworkElement">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding UseExistingTarget}" Value="False">
                        <Setter Property="Visibility" Value="Hidden" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Orientation="Vertical">
        <ScrollViewer
            HorizontalScrollBarVisibility="Auto"
            PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
            VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Vertical">

                <!--  Target source: manual entry or seeded from an existing TS target  -->
                <StackPanel Margin="0,6,0,6" Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="Target Source"
                        ToolTip="Enter target and parameters manually, or start from an existing target, its project, and an exposure plan" />
                    <RadioButton
                        Margin="15,0,0,0"
                        VerticalAlignment="Center"
                        Content="Manual"
                        GroupName="TargetSource"
                        IsChecked="{Binding UseManualTarget}" />
                    <RadioButton
                        Margin="15,0,0,0"
                        VerticalAlignment="Center"
                        Content="Existing Target"
                        GroupName="TargetSource"
                        IsChecked="{Binding UseExistingTarget}" />
                </StackPanel>

                <StackPanel
                    Margin="0,10,0,16"
                    Orientation="Horizontal"
                    Style="{StaticResource ExistingTargetOnly}">
                    <TextBlock VerticalAlignment="Center" Text="Profile" />
                    <ComboBox
                        MinWidth="140"
                        Margin="5,0,15,0"
                        DisplayMemberPath="Value"
                        ItemsSource="{Binding ProfileChoices}"
                        SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" />
                    <TextBlock VerticalAlignment="Center" Text="Project" />
                    <ComboBox
                        MinWidth="140"
                        Margin="5,0,15,0"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding ProjectChoices}"
                        SelectedItem="{Binding SelectedProject, Mode=TwoWay}" />
                    <TextBlock VerticalAlignment="Center" Text="Target" />
                    <ComboBox
                        MinWidth="140"
                        Margin="5,0,15,0"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding TargetChoices}"
                        SelectedItem="{Binding SelectedTarget, Mode=TwoWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="Exposure Plan"
                        ToolTip="Exposure plan supplying the exposure template parameters" />
                    <ComboBox
                        MinWidth="140"
                        Margin="5,0,15,0"
                        DisplayMemberPath="ExposureTemplate.Name"
                        ItemsSource="{Binding ExposurePlanChoices}"
                        SelectedItem="{Binding SelectedExposurePlan, Mode=TwoWay}" />
                    <Button
                        Height="25"
                        Padding="10,0,10,0"
                        VerticalAlignment="Center"
                        Command="{Binding ResetToTargetCommand}"
                        IsEnabled="{Binding Modified.AnyModified}"
                        ToolTip="Restore all parameters to the selected target's values">
                        <TextBlock Foreground="{StaticResource ButtonForegroundBrush}" Text="Reset to Target" />
                    </Button>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="{StaticResource ColumnGap}" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="{StaticResource ColumnGap}" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Target, coordinates, and date range  -->
                    <StackPanel Grid.Column="0">
                        <TextBlock
                            Margin="0,6,0,6"
                            FontWeight="Bold"
                            Text="Target" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="{StaticResource ColumnGap}" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="9" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,0,6"
                                VerticalAlignment="Center"
                                Text="Name" />

                            <!--  Name is a search box (manual) or the selected target's name (existing target), in the same cell.
                                  Wrapped so the visibility style doesn't replace the controls' implicit NINA styles  -->
                            <Border
                                Grid.Row="0"
                                Grid.Column="2"
                                Margin="0,0,0,6"
                                Style="{StaticResource ExistingTargetOnly}">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{Binding SelectedTarget.Name}" />
                            </Border>
                            <Border
                                Grid.Row="0"
                                Grid.Column="2"
                                Margin="0,0,0,6"
                                Style="{StaticResource ManualTargetOnly}">
                                <ninactrl:AutoCompleteBox
                                    Width="140"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    HintText="{ns:Loc LblObjectNameHint}"
                                    PopupBackground="{StaticResource TertiaryBackgroundBrush}"
                                    SearchResult="{Binding DeepSkyObjectSearchVM.TargetSearchResult.Result}"
                                    SelectedSearchResult="{Binding DeepSkyObjectSearchVM.SelectedTargetSearchResult, Mode=TwoWay}"
                                    ShowPopup="{Binding DeepSkyObjectSearchVM.ShowPopup, Mode=TwoWay}"
                                    Text="{Binding DeepSkyObjectSearchVM.TargetName, UpdateSourceTrigger=PropertyChanged}">
                                    <ninactrl:AutoCompleteBox.Background>
                                        <SolidColorBrush Opacity="0.05" Color="{Binding Color, Source={StaticResource PrimaryBrush}}" />
                                    </ninactrl:AutoCompleteBox.Background>
                                </ninactrl:AutoCompleteBox>
                            </Border>

                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,0,0,6"
                                Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="{ns:Loc LblRA}" />
                                <TextBlock Style="{StaticResource ModifiedMarker}" Visibility="{Binding Modified[Coordinates], Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="2"
                                Margin="0,0,0,6"
                                Orientation="Horizontal">
                                <TextBox MinWidth="40" TextAlignment="Right">
                                    <TextBox.Text>
                                        <Binding Path="Coordinates.RAHours" UpdateSourceTrigger="LostFocus">
                                            <Binding.ValidationRules>
                                                <nrules:HoursRule />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                                <TextBlock VerticalAlignment="Center">h</TextBlock>
                                <TextBox
                                    MinWidth="40"
                                    Margin="5,0,0,0"
                                    TextAlignment="Right">
                                    <TextBox.Text>
                                        <Binding Path="Coordinates.RAMinutes" UpdateSourceTrigger="LostFocus">
                                            <Binding.ValidationRules>
                                                <nrules:MinutesRule />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                                <TextBlock VerticalAlignment="Center">m</TextBlock>
                                <TextBox
                                    MinWidth="40"
                                    Margin="5,0,0,0"
                                    TextAlignment="Right">
                                    <TextBox.Text>
                                        <Binding Path="Coordinates.RASeconds" UpdateSourceTrigger="LostFocus">
                                            <Binding.ValidationRules>
                                                <nrules:SecondsRule />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                                <TextBlock VerticalAlignment="Center">s</TextBlock>
                            </StackPanel>

                            <StackPanel
                                Grid.Row="2"
                                Grid.Column="0"
                                Margin="0,0,0,6"
                                Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="{ns:Loc LblDec}" />
                                <TextBlock Style="{StaticResource ModifiedMarker}" Visibility="{Binding Modified[Coordinates], Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Row="2"
                                Grid.Column="2"
                                Margin="0,0,0,6"
                                Orientation="Horizontal">
                                <TextBox MinWidth="40" TextAlignment="Right">
                                    <TextBox.Text>
                                        <MultiBinding Converter="{StaticResource DecDegreeConverter}" UpdateSourceTrigger="LostFocus">
                                            <Binding Path="Coordinates.NegativeDec" />
                                            <Binding Path="Coordinates.DecDegrees">
                                                <Binding.ValidationRules>
                                                    <nrules:DegreesRule />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </MultiBinding>
                                    </TextBox.Text>
                                </TextBox>
                                <TextBlock VerticalAlignment="Center">d</TextBlock>
                                <TextBox
                                    MinWidth="40"
                                    Margin="5,0,0,0"
                                    TextAlignment="Right">
                                    <TextBox.Text>
                                        <Binding Path="Coordinates.DecMinutes" UpdateSourceTrigger="LostFocus">
                                            <Binding.ValidationRules>
                                                <nrules:MinutesRule />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                                <TextBlock VerticalAlignment="Center">m</TextBlock>
                                <TextBox
                                    MinWidth="40"
                                    Margin="5,0,0,0"
                                    TextAlignment="Right">
                                    <TextBox.Text>
                                        <Binding Path="Coordinates.DecSeconds" UpdateSourceTrigger="LostFocus">
                                            <Binding.ValidationRules>
                                                <nrules:SecondsRule />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                                <TextBlock VerticalAlignment="Center">s</TextBlock>
                            </StackPanel>

                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="0"
                                Margin="0,0,0,6"
                                VerticalAlignment="Center"
                                Text="Start Date"
                                ToolTip="Set the start date of the plan" />
                            <DatePicker
                                Grid.Row="4"
                                Grid.Column="2"
                                Margin="0,0,0,6"
                                HorizontalAlignment="Left"
                                SelectedDate="{Binding StartDate}" />

                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="0"
                                Margin="0,0,0,6"
                                VerticalAlignment="Center"
                                Text="Days"
                                ToolTip="Set the number of days in the plan" />
                            <TextBox
                                Grid.Row="5"
                                Grid.Column="2"
                                Width="60"
                                Margin="0,0,0,6"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{Binding PlanDays}" />
                        </Grid>
                    </StackPanel>

                    <!--  Project parameters  -->
                    <Border Grid.Column="2">
                        <StackPanel>
                            <TextBlock
                                Margin="0,6,0,6"
                                FontWeight="Bold"
                                Text="Project" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="{StaticResource ColumnGap}" />
                                    <ColumnDefinition Width="Auto" MinWidth="110" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="Minimum Time"
                                        ToolTip="Minimum imaging time span for the target" />
                                    <TextBlock Style="{StaticResource ModifiedMarker}" Visibility="{Binding Modified[MinimumTime], Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
                                </StackPanel>
                                <ComboBox Grid.Row="0" Grid.Column="2"
                                    Margin="0,0,0,3"
                                    ItemsSource="{Binding MinimumTimeChoices}"
                                    SelectedValue="{Binding MinimumTime, Mode=TwoWay, Converter={StaticResource ImagingMinutesConverter}}" />
                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding UseCustomHorizon, Converter={StaticResource InverseBooleanConverter}}"
                                        Text="Minimum Altitude"
                                        ToolTip="Minimum altitude for the target (when not using a custom horizon)"
                                        ToolTipService.ShowOnDisabled="True" />
                                    <TextBlock Style="{StaticResource ModifiedMarker}" Visibility="{Binding Modified[MinimumAltitude], Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
                                </StackPanel>
                                <ComboBox Grid.Row="1" Grid.Column="2"
                                    Margin="0,0,0,3"
                                    IsEnabled="{Binding UseCustomHorizon, Converter={StaticResource InverseBooleanConverter}}"
                                    ItemsSource="{Binding MinimumAltitudeChoices}"
                                    SelectedValue="{Binding MinimumAltitude, Mode=TwoWay, Converter={StaticResource AltitudeChoicesConverter}}" />
                                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="Maximum Altitude"
                                        ToolTip="Maximum altitude for the target" />
                                    <TextBlock Style="{StaticResource ModifiedMarker}" Visibility="{Binding Modified[MaximumAltitude], Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
                                </StackPanel>
                                <ComboBox Grid.Row="2" Grid.Column="2"
                                    Margin="0,0,0,3"
                                    ItemsSource="{Binding MaximumAltitudeChoices}"
                                    SelectedValue="{Binding MaximumAltitude, Mode=TwoWay, Converter={StaticResource AltitudeChoicesConverter}}" />
                                <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="Use Custom Horizon"
                                        ToolTip="Use the profile's custom horizon" />
                                    <TextBlock Style="{StaticResource ModifiedMarker}" Visibility="{Binding Modified[UseCustomHorizon], Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
                                </StackPanel>
                                <CheckBox Grid.Row="3" Grid.Column="2"
                                    Margin="0,0,0,3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding UseCustomHorizon}" />
                                <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding UseCustomHorizon}"
                                        Text="Horizon Offset"
                                        ToolTip="Offset from custom horizon"
                                        ToolTipService.ShowOnDisabled="True" />
                                    <TextBlock Style="{StaticResource ModifiedMarker}" Visibility="{Binding Modified[HorizonOffset], Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
                                </StackPanel>
                                <TextBox Grid.Row="4" Grid.Column="2"
                                    Margin="0,0,0,3"
                                    VerticalAlignment="Center"
                                    IsEnabled="{Binding UseCustomHorizon}">
                                    <TextBox.Text>
                                        <Binding Path="HorizonOffset" UpdateSourceTrigger="LostFocus">
                                            <Binding.ValidationRules>
                                                <rules:DoubleRangeRule>
                                                    <rules:DoubleRangeRule.ValidRange>
                                                        <rules:DoubleRangeChecker Maximum="90" Minimum="0" />
                                                    </rules:DoubleRangeRule.ValidRange>
                                                </rules:DoubleRangeRule>
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                                <StackPanel Grid.Row="5" Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="Meridian Window"
                                        ToolTip="Limit imaging to this many minutes on either side of target meridian crossing (0 for off)" />
                                    <TextBlock Style="{StaticResource ModifiedMarker}" Visibility="{Binding Modified[MeridianWindow], Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
                                </StackPanel>
                                <TextBox Grid.Row="5" Grid.Column="2" Margin="0,0,0,3" VerticalAlignment="Center">
                                    <TextBox.Text>
                                        <Binding Path="MeridianWindow" UpdateSourceTrigger="LostFocus">
                                            <Binding.ValidationRules>
                                                <rules:IntRangeRule>
                                                    <rules:IntRangeRule.ValidRange>
                                                        <rules:IntRangeChecker Maximum="720" Minimum="0" />
                                                    </rules:IntRangeRule.ValidRange>
                                                </rules:IntRangeRule>
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--  Exposure template parameters  -->
                    <Border Grid.Column="4">
                        <StackPanel>
                            <TextBlock
                                Margin="0,6,0,6"
                                FontWeight="Bold"
                                Text="Exposure Template" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="{StaticResource ColumnGap}" />
                                    <ColumnDefinition Width="Auto" MinWidth="110" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="Acceptable Twilight"
                                        ToolTip="Brightest acceptable twilight" />
                                    <TextBlock Style="{StaticResource ModifiedMarker}" Visibility="{Binding Modified[TwilightLevel], Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
                                </StackPanel>
                                <ComboBox Grid.Row="0" Grid.Column="2"
                                    Margin="0,0,0,3"
                                    ItemsSource="{Binding Source={dm:EnumBindingSource {x:Type astro:TwilightLevel}}}"
                                    SelectedValue="{Binding TwilightLevel}" />
                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="Twilight Offset"
                                        ToolTip="Twilight time offset in minutes (plus or minus)" />
                                    <TextBlock Style="{StaticResource ModifiedMarker}" Visibility="{Binding Modified[MinutesOffset], Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
                                </StackPanel>
                                <TextBox Grid.Row="1" Grid.Column="2" Margin="0,0,0,3" VerticalAlignment="Center">
                                    <TextBox.Text>
                                        <Binding Path="MinutesOffset" UpdateSourceTrigger="LostFocus">
                                            <Binding.ValidationRules>
                                                <rules:IntRangeRule>
                                                    <rules:IntRangeRule.ValidRange>
                                                        <rules:IntRangeChecker Maximum="999" Minimum="-999" />
                                                    </rules:IntRangeRule.ValidRange>
                                                </rules:IntRangeRule>
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="Moon Avoidance"
                                        ToolTip="Enable moon avoidance" />
                                    <TextBlock Style="{StaticResource ModifiedMarker}" Visibility="{Binding Modified[MoonAvoidanceEnabled], Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
                                </StackPanel>
                                <CheckBox Grid.Row="2" Grid.Column="2"
                                    Margin="0,0,0,3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding MoonAvoidanceEnabled}" />
                                <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding MoonAvoidanceEnabled}"
                                        Text="Classic Separation"
                                        ToolTip="Classic moon avoidance separation"
                                        ToolTipService.ShowOnDisabled="True" />
                                    <TextBlock Style="{StaticResource ModifiedMarker}" Visibility="{Binding Modified[MoonAvoidanceSeparation], Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
                                </StackPanel>
                                <TextBox Grid.Row="3" Grid.Column="2"
                                    Margin="0,0,0,3"
                                    VerticalAlignment="Center"
                                    IsEnabled="{Binding MoonAvoidanceEnabled}">
                                    <TextBox.Text>
                                        <Binding Path="MoonAvoidanceSeparation" UpdateSourceTrigger="LostFocus">
                                            <Binding.ValidationRules>
                                                <rules:DoubleRangeRule>
                                                    <rules:DoubleRangeRule.ValidRange>
                                                        <rules:DoubleRangeChecker Maximum="180" Minimum="0" />
                                                    </rules:DoubleRangeRule.ValidRange>
                                                </rules:DoubleRangeRule>
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                                <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding MoonAvoidanceEnabled}"
                                        Text="Classic Width"
                                        ToolTip="Classic moon avoidance width"
                                        ToolTipService.ShowOnDisabled="True" />
                                    <TextBlock Style="{StaticResource ModifiedMarker}" Visibility="{Binding Modified[MoonAvoidanceWidth], Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
                                </StackPanel>
                                <TextBox Grid.Row="4" Grid.Column="2"
                                    Margin="0,0,0,3"
                                    VerticalAlignment="Center"
                                    IsEnabled="{Binding MoonAvoidanceEnabled}">
                                    <TextBox.Text>
                                        <Binding Path="MoonAvoidanceWidth" UpdateSourceTrigger="LostFocus">
                                            <Binding.ValidationRules>
                                                <rules:IntRangeRule>
                                                    <rules:IntRangeRule.ValidRange>
                                                        <rules:IntRangeChecker Maximum="14" Minimum="1" />
                                                    </rules:IntRangeRule.ValidRange>
                                                </rules:IntRangeRule>
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                                <StackPanel Grid.Row="5" Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding MoonAvoidanceEnabled}"
                                        Text="Relaxation / Scale"
                                        ToolTip="Scale the impact or disable relaxation"
                                        ToolTipService.ShowOnDisabled="True" />
                                    <TextBlock Style="{StaticResource ModifiedMarker}" Visibility="{Binding Modified[MoonRelaxScale], Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
                                </StackPanel>
                                <ComboBox Grid.Row="5" Grid.Column="2"
                                    Margin="0,0,0,3"
                                    IsEnabled="{Binding MoonAvoidanceEnabled}"
                                    ItemsSource="{Binding RelaxScaleChoices}"
                                    SelectedValue="{Binding MoonRelaxScale, Mode=TwoWay, Converter={StaticResource RelaxScaleChoicesConverter}}" />
                                <StackPanel Grid.Row="6" Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding RelaxEnabled}"
                                        Text="Relax Min Altitude"
                                        ToolTip="Minimum altitude for relaxation, avoidance is disabled completely if moon is lower than this"
                                        ToolTipService.ShowOnDisabled="True" />
                                    <TextBlock Style="{StaticResource ModifiedMarker}" Visibility="{Binding Modified[MoonRelaxMinAltitude], Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
                                </StackPanel>
                                <TextBox Grid.Row="6" Grid.Column="2"
                                    Margin="0,0,0,3"
                                    VerticalAlignment="Center"
                                    IsEnabled="{Binding RelaxEnabled}">
                                    <TextBox.Text>
                                        <Binding Path="MoonRelaxMinAltitude" UpdateSourceTrigger="LostFocus">
                                            <Binding.ValidationRules>
                                                <rules:DoubleRangeRule>
                                                    <rules:DoubleRangeRule.ValidRange>
                                                        <rules:DoubleRangeChecker Maximum="0" Minimum="-90" />
                                                    </rules:DoubleRangeRule.ValidRange>
                                                </rules:DoubleRangeRule>
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                                <StackPanel Grid.Row="7" Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding RelaxEnabled}"
                                        Text="Relax Max Altitude"
                                        ToolTip="Maximum altitude for relaxation, classic avoidance applies if moon is above this"
                                        ToolTipService.ShowOnDisabled="True" />
                                    <TextBlock Style="{StaticResource ModifiedMarker}" Visibility="{Binding Modified[MoonRelaxMaxAltitude], Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
                                </StackPanel>
                                <TextBox Grid.Row="7" Grid.Column="2"
                                    Margin="0,0,0,3"
                                    VerticalAlignment="Center"
                                    IsEnabled="{Binding RelaxEnabled}">
                                    <TextBox.Text>
                                        <Binding Path="MoonRelaxMaxAltitude" UpdateSourceTrigger="LostFocus">
                                            <Binding.ValidationRules>
                                                <rules:DoubleRangeRule>
                                                    <rules:DoubleRangeRule.ValidRange>
                                                        <rules:DoubleRangeChecker Maximum="30" Minimum="0" />
                                                    </rules:DoubleRangeRule.ValidRange>
                                                </rules:DoubleRangeRule>
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                                <StackPanel Grid.Row="8" Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding RelaxEnabled}"
                                        Text="Moon Must Be Down"
                                        ToolTip="Moon avoidance is absolute above the relax Maximum Altitude, regardless of actual separation or moon phase"
                                        ToolTipService.ShowOnDisabled="True" />
                                    <TextBlock Style="{StaticResource ModifiedMarker}" Visibility="{Binding Modified[MoonDownEnabled], Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
                                </StackPanel>
                                <CheckBox Grid.Row="8" Grid.Column="2"
                                    Margin="0,0,0,3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding MoonDownEnabled}"
                                    IsEnabled="{Binding RelaxEnabled}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Margin="0,10,0,10" Orientation="Horizontal">
                    <ninactrl:CancellableButton
                        Width="250"
                        Height="35"
                        Margin="5"
                        HorizontalAlignment="Left"
                        ButtonText="Daily Details"
                        CancelButtonImage="{StaticResource CancelSVG}"
                        CancelCommand="{Binding CancelDailyDetailsCommand}"
                        CancelToolTip="Cancel"
                        Command="{Binding DailyDetailsCommand}"
                        ToolTip="Display a table of daily imaging circumstances" />
                    <ninactrl:CancellableButton
                        Width="250"
                        Height="35"
                        Margin="5"
                        HorizontalAlignment="Left"
                        ButtonText="Imaging Season"
                        CancelButtonImage="{StaticResource CancelSVG}"
                        CancelCommand="{Binding CancelImagingSeasonCommand}"
                        CancelToolTip="Cancel"
                        Command="{Binding ImagingSeasonCommand}"
                        ToolTip="Display entire imaging season for target, applying all filters (be patient)" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!--  Results: outside the horizontal ScrollViewer so the table gets the panel width and its own wheel scrolling  -->
        <Grid>
            <ninactrl:LoadingControl
                MaxWidth="100"
                MaxHeight="100"
                Margin="0,30,0,30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                LoadingImageBrush="{StaticResource PrimaryBrush}"
                Visibility="{Binding DailyDetailsRunning, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />

            <!--  Daily Details table  -->
            <Grid DataContext="{Binding DailyDetailsResults}" Visibility="{Binding DataContext.ShowDailyDetailsResults, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid
                    Height="375"
                    AutoGenerateColumns="False"
                    HeadersVisibility="Column"
                    HorizontalScrollBarVisibility="Disabled"
                    IsReadOnly="True"
                    ItemsSource="{Binding ItemPage, IsAsync=True}"
                    RowHeight="28"
                    SelectedItem="{Binding SelectedItem}"
                    SelectionMode="Single">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="{x:Type DataGridColumnHeader}">
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="MinHeight" Value="25" />
                            <Setter Property="Margin" Value="5,3,5,3" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="FontSize" Value="14" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="MinHeight" Value="22" />
                            <Setter Property="Margin" Value="5,3,5,3" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource ButtonBackgroundBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="False">
                                    <Setter Property="Background" Value="Transparent" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="MinHeight" Value="28" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SecondaryBackgroundBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="False">
                                    <Setter Property="Background" Value="Transparent" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <!--  Shown for the selected day  -->
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="{StaticResource ColumnGap}" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="{StaticResource ColumnGap}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="5" Orientation="Vertical">
                                    <TextBlock Margin="0,3,0,0" Text="Start Imaging Time:" />
                                    <TextBlock Margin="0,3,0,0" Text="End Imaging Time:" />
                                    <TextBlock Margin="0,3,0,0" Text="Imaging Time:" />
                                    <TextBlock Margin="0,3,0,0" Text="Transit Time:" />
                                    <TextBlock Margin="0,3,0,0" Text="Moon Illumination:" />
                                    <TextBlock Margin="0,3,0,0" Text="Moon Angle:" />
                                    <TextBlock Margin="0,3,0,0" Text="Moon Avoid Angle:" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="5" Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,3,0,0" Text="{Binding StartImagingTime, StringFormat={}{0:HH:mm:ss}}" />
                                        <TextBlock Margin="0,3,0,0" Text="{Binding StartLimitingFactor}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,3,0,0" Text="{Binding EndImagingTime, StringFormat={}{0:HH:mm:ss}}" />
                                        <TextBlock Margin="0,3,0,0" Text="{Binding EndLimitingFactor}" />
                                    </StackPanel>
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        Foreground="{Binding ImagingTimeColor}"
                                        Text="{Binding ImagingTime}" />
                                    <TextBlock Margin="0,3,0,0" Text="{Binding TransitTime, StringFormat={}{0:HH:mm:ss}}" />
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        Foreground="{Binding MoonIlluminationColor}"
                                        Text="{Binding MoonIllumination, StringFormat={}{0:F0}%}" />
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        Foreground="{Binding MoonSeparationColor}"
                                        Text="{Binding MoonSeparation, StringFormat={}{0:F0}°}" />
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        Foreground="{Binding MoonAvoidanceSeparationColor}"
                                        Text="{Binding MoonAvoidanceSeparationDisplay}" />
                                </StackPanel>
                                <ContentControl
                                    Grid.Column="4"
                                    MinHeight="200"
                                    Margin="5"
                                    HorizontalAlignment="Left"
                                    Content="{Binding Chart}" />
                            </Grid>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn
                            Width="50"
                            CanUserSort="False"
                            Header="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Path
                                        Width="15"
                                        Height="15"
                                        Data="{Binding Status, Converter={StaticResource StatusConverter}}"
                                        Fill="{Binding Status, Converter={StaticResource StatusMarkColorConverter}}"
                                        Stretch="Uniform"
                                        ToolTip="{Binding StatusMessage}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn
                            Width="*"
                            CanUserSort="False"
                            Header="Start">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StartImagingTime, StringFormat={}{0:MM/dd HH:mm}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn
                            Width="*"
                            CanUserSort="False"
                            Header="End">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding EndImagingTime, StringFormat={}{0:MM/dd HH:mm}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn
                            Width="*"
                            CanUserSort="False"
                            Header="Imaging Time">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="{Binding ImagingTimeColor}" Text="{Binding ImagingTime}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn
                            Width="*"
                            CanUserSort="False"
                            Header="Moon Illum">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="{Binding MoonIlluminationColor}" Text="{Binding MoonIllumination, StringFormat={}{0:F0}%}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn
                            Width="*"
                            CanUserSort="False"
                            Header="Moon Angle">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="{Binding MoonSeparationColor}" Text="{Binding MoonSeparation, StringFormat={}{0:F0}°}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!--  Pager  -->
                <StackPanel
                    Grid.Row="1"
                    Height="35"
                    Margin="5,0,5,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal">
                    <Button
                        Width="35"
                        Margin="5,2.5,0,2.5"
                        Command="{Binding FirstPageCommand}"
                        Content="&lt;|" />
                    <Button
                        Width="35"
                        Margin="5,2.5,0,2.5"
                        Command="{Binding PrevPageCommand}"
                        Content="&lt;&lt;" />
                    <ComboBox
                        Margin="5,2.5,0,2.5"
                        ItemsSource="{Binding Pages}"
                        SelectedValue="{Binding CurrentPage, Mode=TwoWay}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding PageByNumberCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>
                    <TextBlock
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Text="{ns:Loc LblOf}" />
                    <TextBlock
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Text="{Binding Pages.Count}" />
                    <Button
                        Width="35"
                        Margin="5,2.5,0,2.5"
                        Command="{Binding NextPageCommand}"
                        Content="&gt;&gt;" />
                    <Button
                        Width="35"
                        Margin="5,2.5,0,2.5"
                        Command="{Binding LastPageCommand}"
                        Content="|&gt;" />
                </StackPanel>
            </Grid>

            <!--  Imaging Season chart  -->
            <Grid Visibility="{Binding ShowImagingSeasonResults, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
                <ninactrl:LoadingControl
                    MaxWidth="100"
                    MaxHeight="100"
                    Margin="0,30,0,30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    LoadingImageBrush="{StaticResource PrimaryBrush}"
                    Visibility="{Binding ImagingSeasonRunning, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
                <TextBlock
                    Margin="0,20,0,20"
                    HorizontalAlignment="Center"
                    Text="{Binding ImagingSeasonMessage}"
                    Visibility="{Binding ImagingSeasonMessage, Converter={StaticResource NullToVisibilityCollapsedConverter}}" />
                <oxy:PlotView
                    Height="410"
                    HorizontalAlignment="Stretch"
                    Controller="{Binding ImagingSeasonPlotModel.PlotController}"
                    Model="{Binding ImagingSeasonPlotModel.PlotModel}"
                    Visibility="{Binding ImagingSeasonPlotModel, Converter={StaticResource NullToVisibilityCollapsedConverter}}" />
            </Grid>
        </Grid>
    </StackPanel>
</UserControl>
